            { "value": "live-release", "label": "Live release" },
            { "value": "live-lookup", "label": "Live lookup" },
            { "value": "repository-snapshot", "label": "Repository snapshot" }
          ]
        }
      ],
      "preferred_columns": [
        "decision_rank",
        "source_id",
        "source_name",
        "publisher",
        "source_tier",
