{
  "name": "org-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:metadata": "node scripts/build-metadata.mjs",
    "pretypecheck": "npm run build:metadata",
    "pretest": "npm run build:metadata",
    "precheck:bundle": "npm run build:metadata",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "events:check-config": "node --import tsx scripts/check-event-config.mjs",
    "check:bundle": "esbuild src/index.ts --bundle --platform=node --conditions=workerd,worker,browser --format=esm --external:cloudflare:* --outfile=dist/worker-check.mjs",
    "db:migrate:local": "wrangler d1 migrations apply org --local",
    "db:migrate:remote": "wrangler d1 migrations apply org --remote"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.131.0"
  }
}
