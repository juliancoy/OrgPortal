  },
  "dependencies": {
    "hono": "^4.13.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.120.0"
  }
}
