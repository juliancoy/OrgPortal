{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "org-codecollective",
  "main": "src/index.ts",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "compatibility_date": "2026-06-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "PIDP_BASE_URL": "https://id.codecollective.us",
    "PUBLIC_PORTAL_BASE_URL": "https://orgportal.cc",
    "MCP_RESOURCE_CONFIG_JSON": "{\"https://medtech.social/api/org/mcp\": {\"name\": \"MedTech\", \"organizationId\": \"org-baltimore-medtech\"}, \"https://lifetech.fyi/api/org/mcp\": {\"name\": \"LifeTech\", \"organizationId\": \"ef646755-9443-4c7b-ba4b-a7a29754f666\", \"introspectionSecretBinding\": \"MCP_LIFETECH_INTROSPECTION_SECRET\"}, \"https://orgportal.cc/api/org/mcp\": {\"name\": \"OrgPortal\", \"introspectionSecretBinding\": \"MCP_ORGPORTAL_INTROSPECTION_SECRET\"}}",
    "CHAT_API_ORIGIN": "https://chat-codecollective.jcloiacon.workers.dev",
    "ADMIN_EMAILS": "",
    "ADMIN_USER_IDS": ""
  },
  "services": [
    { "binding": "CHAT_ORGANIZATION_ROOMS", "service": "chat-codecollective", "entrypoint": "OrganizationRooms" },
    { "binding": "CHAT_SERVICE", "service": "chat-codecollective" }
  ],
  "d1_databases": [
    {
      "binding": "JOURNAL_DB",
      "database_name": "org-journal",
      "database_id": "ba4abef1-be7d-4109-86c2-e87b349d22bf",
      "migrations_dir": "journal-migrations"
    },
    {
      "binding": "DB",
      "database_name": "org",
      "database_id": "a71a2306-3d82-44cb-a50c-d7fdffaacdc7"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SCAN_IMAGES",
      "bucket_name": "org-scan-images"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PUSH_QUEUE",
        "queue": "org-web-push"
      }
    ],
    "consumers": [
      {
        "queue": "org-web-push",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "org-web-push-dead-letter"
      }
    ]
  }
}
