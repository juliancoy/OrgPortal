{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "org-codecollective",
  "main": "src/index.ts",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "compatibility_date": "2026-06-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "redact_query_string": true,
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "QCASH_GATEWAY_URL": "",
    "QCASH_CHAIN_ID": "",
    "PQCOIN_GATEWAY_URL": "",
    "PQCOIN_CHAIN_ID": "",
    "CLOUDFLARE_ANALYTICS_ACCOUNT_ID": "42d86bec91224cb6ef236aff4db81d30",
    "CLOUDFLARE_ANALYTICS_HOSTS": "orgportal.cc,lifetech.fyi,medtech.social,timebank.codecollective.us,bmoretimebank.codecollective.us,portal.deism.church",
    "PIDP_BASE_URL": "https://orgportal.cc/pidp",
    "PUBLIC_PORTAL_BASE_URL": "https://orgportal.cc",
    "EMAIL_POSTAL_ADDRESS": "1110 W Cross St Baltimore MD",
    "MCP_RESOURCE_CONFIG_JSON": "{\"https://medtech.social/api/org/mcp\": {\"name\": \"MedTech\", \"organizationId\": \"org-baltimore-medtech\"}, \"https://lifetech.fyi/api/org/mcp\": {\"name\": \"LifeTech\", \"organizationId\": \"ef646755-9443-4c7b-ba4b-a7a29754f666\", \"introspectionSecretBinding\": \"MCP_LIFETECH_INTROSPECTION_SECRET\"}, \"https://orgportal.cc/mcp\": {\"name\": \"OrgPortal\", \"introspectionSecretBinding\": \"MCP_ORGPORTAL_INTROSPECTION_SECRET\"}}",
    "CHAT_API_ORIGIN": "https://chat-codecollective.jcloiacon.workers.dev",
    "ADMIN_EMAILS": "",
    "ADMIN_USER_IDS": ""
  },
  "send_email": [{"name":"SUPPORT_EMAIL","allowed_sender_addresses":["service@lifetech.fyi","service@notify.orgportal.cc"]}],
  "services": [
    { "binding": "CHAT_ORGANIZATION_ROOMS", "service": "chat-codecollective", "entrypoint": "OrganizationRooms" },
    { "binding": "CHAT_SERVICE", "service": "chat-codecollective" }
  ],
  "d1_databases": [
    {"binding": "FEDERAL_0", "database_name": "org-federal-history-0", "database_id": "0865b586-0339-4ce9-88d2-5aecfebe592e", "migrations_dir": "financial-migrations"},
    {"binding": "FEDERAL_1", "database_name": "org-federal-history-1", "database_id": "269e406f-a74d-46a1-9843-5ba37d68919a", "migrations_dir": "financial-migrations"},
    {"binding": "FEDERAL_2", "database_name": "org-federal-history-2", "database_id": "a74e1c5d-7b7c-4f6e-a8a4-8b1fb1f4f444", "migrations_dir": "financial-migrations"},
    {"binding": "FEDERAL_3", "database_name": "org-federal-history-3", "database_id": "5e18e7b6-e2d0-4ec4-85a0-d7199ddb08e3", "migrations_dir": "financial-migrations"},
    {
      "binding": "JOURNAL_DB",
      "database_name": "org-journal",
      "database_id": "ba4abef1-be7d-4109-86c2-e87b349d22bf",
      "migrations_dir": "journal-migrations"
    },
    {
      "binding": "DB",
      "database_name": "org",
      "database_id": "a71a2306-3d82-44cb-a50c-d7fdffaacdc7"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SCAN_IMAGES",
      "bucket_name": "org-scan-images"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PUSH_QUEUE",
        "queue": "org-web-push"
      }
    ],
    "consumers": [
      {
        "queue": "org-web-push",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "org-web-push-dead-letter"
      }
    ]
  }
}
