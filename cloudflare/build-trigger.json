{
  "trigger_name": "OrgPortal production",
  "branch_includes": [
    "main"
  ],
  "branch_excludes": [],
  "path_includes": [
    "web/**",
    "shared/**",
    "org-worker/**",
    "chat-worker/**",
    "cloudflare/**",
    "scripts/release.mjs",
    "docs/privacy/**"
  ],
  "path_excludes": [],
  "root_directory": "/",
  "build_command": "npm ci --prefix web && npm ci --prefix org-worker && npm ci --prefix chat-worker && node scripts/release.mjs check all && node scripts/release.mjs build all",
  "deploy_command": "node scripts/release.mjs deploy all",
  "build_caching_enabled": true
}
