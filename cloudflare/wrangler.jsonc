{
  "$schema": "../org-worker/node_modules/wrangler/config-schema.json",
  "name": "orgportal-web",
  "main": "worker.js",
  "compatibility_date": "2026-04-24",
  "workers_dev": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": "../.release/site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true
  },
  "vars": {
    "ORG_API_ORIGIN": "https://org-codecollective.jcloiacon.workers.dev",
    "GOVERNANCE_API_ORIGIN": "https://org-codecollective.jcloiacon.workers.dev",
    "PIDP_API_ORIGIN": "https://id.orgportal.cc",
    "PIDP_PROXY_ORIGIN": "https://pidp-codecollective.jcloiacon.workers.dev",
    "CHAT_API_ORIGIN": "https://chat-codecollective.jcloiacon.workers.dev",
    "ORGPORTAL_SITE_HOSTS": "orgportal.cc,medtech.social,lifetech.fyi,portal.deism.church"
  },
  "r2_buckets": [
    {
      "binding": "JOBS_BUCKET",
      "bucket_name": "codecollective-usajobs"
    },
    {
      "binding": "VACANTS_BUCKET",
      "bucket_name": "codecollective-usajobs"
    },
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "codecollective-media"
    }
  ],
  "services": [
    {
      "binding": "DEV_ASSETS",
      "service": "codecollective-site-preview"
    }
  ],
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ]
}
